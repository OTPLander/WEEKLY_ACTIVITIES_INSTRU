            <o>
              <v n="TextID">"INST_OFF"</v>
              <v n="TextDefault">"Sistema apagado.
Active el interruptor para iniciar."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Sistema itzalita.
Piztu etengailua hasteko.</v>
                <v>Sistema apagat.
Activi l'interruptor per iniciar.</v>
                <v>System off.
Turn on the switch to start.</v>
              </l>
            </o>
            <o>
              <v n="TextID">"INST_WAIT"</v>
              <v n="TextDefault">"Modo Espera (Parpadeo).
Pulse BOTÓN VERDE para inicio."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Itxarote modua (Keinuka).
Sakatu BOTOI BERDEA hasteko.</v>
                <v>Mode espera (Parpelleig).
Premi BOTÓ VERD per iniciar.</v>
                <v>Standby mode (Blinking).
Press GREEN BUTTON to start.</v>
              </l>
            </o>
            <o>
              <v n="TextID">"INST_NORMAL"</v>
              <v n="TextDefault">"Funcionamiento Normal.
Pulse BOTÓN ROJO para Setup."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Funtzionamendu normala.
Sakatu BOTOI GORRIA konfiguratzeko.</v>
                <v>Funcionament normal.
Premi BOTÓ VERMELL per al Setup.</v>
                <v>Normal operation.
Press RED BUTTON for Setup.</v>
              </l>
            </o>
            <o>
              <v n="TextID">"INST_SETUP_Y"</v>
              <v n="TextDefault">"Setup: Tiempo AMARILLO.
Pulse BOTÓN ROJO para guardar."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Setup: Horiaren denbora.
Sakatu BOTOI GORRIA gordetzeko.</v>
                <v>Setup: Temps GROC.
Premi BOTÓ VERMELL per guardar.</v>
                <v>Setup: YELLOW time.
Press RED BUTTON to save.</v>
              </l>
            </o>
            <o>
              <v n="TextID">"INST_SETUP_R"</v>
              <v n="TextDefault">"Setup: Tiempo ROJO.
Pulse BOTÓN ROJO para guardar."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Setup: Gorriaren denbora.
Sakatu BOTOI GORRIA gordetzeko.</v>
                <v>Setup: Temps VERMELL.
Premi BOTÓ VERMELL per guardar.</v>
                <v>Setup: RED time.
Press RED BUTTON to save.</v>
              </l>
            </o>
            <o>
              <v n="TextID">"INST_SETUP_G"</v>
              <v n="TextDefault">"Setup: Tiempo VERDE.
Pulse BOTÓN ROJO para terminar."</v>
              <l n="LanguageTexts" t="ArrayList" cet="String">
                <v>Setup: Berdearen denbora.
Sakatu BOTOI GORRIA amaitzeko.</v>
                <v>Setup: Temps VERD.
Premi BOTÓ VERMELL per acabar.</v>
                <v>Setup: GREEN time.
Press RED BUTTON to finish.</v>
              </l>
            </o>
